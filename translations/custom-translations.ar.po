msgid ""
"[user:display-name],\n"
"\n"
"Thank you for registering at [site:name]. "
"Your application for an account is currently pending approval. Once it "
"has been approved, you will receive another email containing "
"information about how to log in, set your password, and other "
"details.\n"
"\n"
"--  [site:name] team"
msgstr ""
"[user:display-name]،\r\n"
"\r\n"
"شكرًا لتسجيلك في "
"[site:name]. طلبك للحصول على حساب ما زال "
"بانتظار الموافقة. بعد الموافقة، "
"ستتلقى رسالة إلكترونية أخرى تحتوي على "
"معلومات حول كيفية تسجيل الدخول، "
"وتعيين كلمة المرور، وتفاصيل "
"أخرى.\r\n"
"\r\n"
"-- فريق [site:name]"

