  image: content.field_featured_media|render,
  text: [{'#markup':'<strong>Published by:</strong> ' ~ node.field_display_groups.0.entity.label() ~ content.field_summary|render}],
  items: [content.field_news_type, content.field_public_notice_type]
} %}
