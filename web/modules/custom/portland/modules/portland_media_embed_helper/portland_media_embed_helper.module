<?php

use Drupal\editor\Entity\Editor;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_library_info_alter().
 *
 * Load image_compare's JS when entity_embed's own CKEditor5 plugin is
 * loaded so the slider is usable in CKEditor.
 */
function portland_media_embed_helper_library_info_alter(array &$libraries, $extension) {
  if ($extension === 'entity_embed' && isset($libraries['entity_embed'])) {
    $libraries['entity_embed']['dependencies'][] = 'image_compare/image_compare';
  }
}

/**
 * Implements hook_form_alter().
 */
function portland_media_embed_helper_form_entity_embed_dialog_alter(array &$form, FormStateInterface $form_state, $form_id)
{
  $entity = $form_state->get('entity');
  $entity_element = $form_state->get('entity_element');
  // if no entity has been selected yet or we're not on the embed dialog, there's nothing for us to do
  if (!$entity || !$entity_element || !array_key_exists('data-embed-button', $form['attributes'])) {
    return;
  }

  // Map of which options we want enabled on each media type
  $attributes_enabled_by_bundle = [
    'document' => ['data-alt-link-text'],
    'iframe_embed' => ['data-align', 'data-aspect-ratio'],
    'image' => ['data-align', 'data-caption', 'data-alt-override'],
    'image_slider' => ['data-caption', 'data-label-preset'],
    'map' => ['data-align', 'data-caption'],
    'video' => ['data-align', 'data-caption', 'data-start-cue'],
    'content_fragment' => [],
  ];
  $attributes_enabled = $attributes_enabled_by_bundle[$entity->bundle()];

  // Hide additional fields we don't want
  $form['attributes']['data-entity-embed-display-settings']['#access'] = false;
  // Move view mode selection to bottom
  $form['attributes']['data-entity-embed-display']['#weight'] = 99;

  if (in_array('data-caption', $attributes_enabled)) {
    $form['attributes']['data-caption']['#weight'] = 2;
  } else {
    $form['attributes']['data-caption']['#access'] = false;
  }

  if (in_array('data-label-preset', $attributes_enabled)) {
    $preset_options = [];
    foreach (_portland_media_embed_helper_image_slider_label_presets() as $key => $labels) {
      $preset_options[$key] = implode(' / ', $labels);
    }
    $preset_options['custom'] = t('Custom text');
    $preset_options['no_label'] = t('No label');

    $form['attributes']['data-label-preset'] = [
      '#type' => 'select',
      '#title' => t('Image labels'),
      '#weight' => 2,
      '#options' => $preset_options,
      '#default_value' => $entity_element['data-label-preset'] ?? 'before_after',
      '#description' => t('Choose the label shown on each of the two images.'),
    ];

    $custom_label_states = [
      'visible' => [
        ':input[name="attributes[data-label-preset]"]' => ['value' => 'custom'],
      ],
      // Only marks the field visually required and adds the HTML5 required
      // attribute via core/drupal.states; the actual required validation is
      // enforced server-side in
      // portland_media_embed_helper_entity_embed_dialog_validate().
      'required' => [
        ':input[name="attributes[data-label-preset]"]' => ['value' => 'custom'],
      ],
    ];
    $form['attributes']['data-label-custom-1'] = [
      '#type' => 'textfield',
      '#title' => t('Label for image 1'),
      '#weight' => 3,
      '#maxlength' => 64,
      '#default_value' => $entity_element['data-label-custom-1'] ?? '',
      '#states' => $custom_label_states,
    ];
    $form['attributes']['data-label-custom-2'] = [
      '#type' => 'textfield',
      '#title' => t('Label for image 2'),
      '#weight' => 3,
      '#maxlength' => 64,
      '#default_value' => $entity_element['data-label-custom-2'] ?? '',
      '#states' => $custom_label_states,
    ];
  }

  if (in_array('data-align', $attributes_enabled)) {
    $alignments = [
      [
        'icon' => 'img-100.png',
        'name' => 'Full width',
        'id' => 'responsive-full',
      ],
      [
        'icon' => 'img-narrow.png',
        'name' => 'Narrow',
        'id' => 'narrow',
      ],
      [
        'icon' => 'img-50-fill.png',
        'name' => '50% fill',
        'id' => 'responsive-right',
      ],
      [
        'icon' => 'img-50-fit.png',
        'name' => '50% fit',
        'id' => 'right',
      ],
    ];
    $alignments_enabled_by_bundle = [
      'iframe_embed' => ['responsive-full', 'responsive-right'],
      'image' => ['responsive-full', 'narrow', 'responsive-right', 'right'],
      'map' => ['responsive-full', 'responsive-right'],
      'video' => ['responsive-full', 'responsive-right'],
    ];
    $alignments_enabled = $alignments_enabled_by_bundle[$entity->bundle()];

    $form['attributes']['data-align'] = [
      '#type' => 'radios',
      '#title' => t('Alignment'),
      '#weight' => 1,
      '#default_value' => $entity_element['data-align'] ?? 'responsive-full',
      '#attributes' => ['class' => ['container-inline']],
    ];

    foreach ($alignments as $alignment) {
      if (!in_array($alignment['id'], $alignments_enabled)) continue;

      $form['attributes']['data-align']['#options'][$alignment['id']]
        = "{$alignment['name']}<br><img src=\"/themes/custom/cloudy/images/icons/embed-alignment/{$alignment['icon']}\" />";
    }
  } else {
    $form['attributes']['data-align']['#access'] = false;
  }

  if (in_array('data-alt-override', $attributes_enabled)) {
    $form['attributes']['data-is-decorative'] = [
      '#type' => 'checkbox',
      '#title' => t('This is a decorative image'),
      '#weight' => 4,
      '#description' => t('Marks image as decorative for screen readers and other assistive technology.<br>Check this box if the image is only used for ambiance or repeats text that is already nearby on the page.<br>See the <a href=":alt_decision">WAI alt decision tree</a> and <a href=":decorative_images">Decorative Images guide</a> for more info.', [
        ':alt_decision' => 'https://www.w3.org/WAI/tutorials/images/decision-tree',
        ':decorative_images' => 'https://www.w3.org/WAI/tutorials/images/decorative',
      ]),
      '#return_value' => "true",
      '#default_value' => $entity_element['data-is-decorative'] ?? false,
    ];
    $form['attributes']['data-alt-override'] = [
      '#type' => 'textarea',
      '#title' => t('Override alt text'),
      '#weight' => 5,
      '#rows' => 2,
      '#description' => t("Provide an overridden alt text for the image. If left blank, the image's default alt text will be used."),
      '#states' => [
        'invisible' => [
          ':input[name="attributes[data-is-decorative]"]' => ['checked' => true],
        ],
      ],
      '#default_value' => $entity_element['data-alt-override'] ?? '',
    ];
  }

  if (in_array('data-start-cue', $attributes_enabled)) {
    $form['attributes']['data-start-cue'] = [
      '#type' => 'textfield',
      '#title' => t('Video start cue time (optional)'),
      '#weight' => 3,
      '#placeholder' => '0',
      '#description' => t('Provide a start time in seconds'),
      '#default_value' => $entity_element['data-start-cue'] ?? '',
    ];
  }

  if (in_array('data-aspect-ratio', $attributes_enabled)) {
    $form['attributes']['data-aspect-ratio'] = [
      '#type' => 'radios',
      '#title' => t('Aspect ratio'),
      '#weight' => 2,
      '#options' => [
        '16/9' => t('16x9'),
        '4/3' => t('4x3'),
        '1/1' => t('1x1'),
        '9/16' => t('9x16'),
      ],
      '#default_value' => $entity_element['data-aspect-ratio'] ?? '16/9',
      '#attributes' => ['class' => ['container-inline']],
    ];
  }

  if (in_array('data-alt-link-text', $attributes_enabled)) {
    $form['attributes']['data-alt-link-text'] = [
      '#type' => 'textfield',
      '#title' => t('Link text'),
      '#weight' => 1,
      '#description' => t('Provide an alternative link text for the document.  Leave blank to use the document\'s display name.'),
      '#default_value' => $entity_element['data-alt-link-text'] ?? '',
    ];
  }

  // if entity type is translatable, add translation info
  if ($entity->isTranslatable()) {
    $entity_translations = $entity->getTranslationLanguages(FALSE);
    $entity_translation_names = array_map(fn($lang) => $lang->getName(), $entity_translations);
    $user_can_translate = \Drupal::currentUser()->hasPermission('translate editable entities');
    $form['attributes']['data-translate-media'] = [
      '#type' => 'item',
      '#title' => t('Translate this media item'),
      '#weight' => 0,
      '#markup' => $user_can_translate
        ? '<a target="_blank" href="/media/' . $entity->id() . '/translations">Translate</a>'
        : 'You do not have the translator role.',
      '#description' => (count($entity_translations) > 0
        ? 'Already translated in: ' .  join(', ', $entity_translation_names)
        : 'This media currently has no translations.'),
    ];
  }

  $form['#validate'][] = 'portland_media_embed_helper_entity_embed_dialog_validate';
  $form['#submit'][] = 'portland_media_embed_helper_entity_embed_dialog_submit';
  $form['#after_build'][] = 'portland_media_embed_helper_after_build';
}

/**
 * Requires the custom labels when the "Custom text" preset is selected.
 *
 * The #states 'required' key (set in
 * portland_media_embed_helper_form_entity_embed_dialog_alter()) only
 * enforces this client-side, so it's re-checked here on the server.
 */
function portland_media_embed_helper_entity_embed_dialog_validate(array &$form, FormStateInterface $form_state) {
  if ($form_state->getValue(['attributes', 'data-label-preset']) !== 'custom') {
    return;
  }

  $labels = [
    1 => t('Label for image 1'),
    2 => t('Label for image 2'),
  ];
  foreach ($labels as $n => $label_title) {
    $key = "data-label-custom-$n";
    if (trim((string) $form_state->getValue(['attributes', $key])) === '') {
      $form_state->setError($form['attributes'][$key], t('@label is required when "Custom text" is selected.', ['@label' => $label_title]));
    }
  }
}

/**
 * Defines the selectable Image Slider label presets.
 *
 * Keyed by machine name so the editor's choice can be stored as a data
 * attribute on the embed (see
 * portland_media_embed_helper_form_entity_embed_dialog_alter()) and the
 * actual label text resolved as a translatable interface string at render
 * time (see portland_media_embed_helper_media_embed_alter()).
 *
 * @return array
 *   An array of [image_1_label, image_2_label] pairs, keyed by preset id.
 */
function _portland_media_embed_helper_image_slider_label_presets() {
  return [
    'before_after' => [t('Before'), t('After')],
    'option_1_2' => [t('Option 1'), t('Option 2')],
    'existing_proposed' => [t('Existing'), t('Proposed')],
  ];
}

/**
 * Implements hook_media_embed_alter().
 *
 * Injects the per-embed label preset chosen in the entity_embed dialog into
 * the rendered images, by setting the "caption" value the
 * image_compare formatter/template expects for each image (not to be
 * confused with the whole-slider data-caption attribute). If the editor
 * chose the "custom" preset, the editor-supplied text in the
 * data-label-custom-1/2 attributes is used instead of a fixed pair. If the
 * editor chose "no_label", no caption is set at all, so the image_compare
 * template doesn't render the <figcaption> pill badge.
 *
 * The images aren't built yet when this hook fires (the referenced media
 * entity's fields are populated later, by its own #pre_render callback), so
 * the labels are applied via an additional #pre_render callback appended
 * after it.
 */
function portland_media_embed_helper_media_embed_alter(array &$build, EntityInterface $entity, array $context) {
  if ($entity->bundle() !== 'image_slider' || empty($build['entity'])) {
    return;
  }

  $preset = $context['data-label-preset'] ?? 'before_after';

  if ($preset === 'no_label') {
    $labels = ['', ''];
  } elseif ($preset === 'custom') {
    // Enforce the same 64-character limit as the dialog's #maxlength, in
    // case the embed's HTML was edited directly (e.g. via source editing).
    $labels = [
      mb_substr((string) ($context['data-label-custom-1'] ?? ''), 0, 32),
      mb_substr((string) ($context['data-label-custom-2'] ?? ''), 0, 32),
    ];
  } else {
    $presets = _portland_media_embed_helper_image_slider_label_presets();
    $labels = $presets[$preset] ?? $presets['before_after'];
  }

  $build['entity']['#pre_render'][] = function (array $element) use ($labels) {
    foreach (array_values($labels) as $delta => $label) {
      if ($label !== '' && isset($element['image']['#images'][$delta])) {
        $element['image']['#images'][$delta]['caption'] = $label;
      }
    }
    return $element;
  };
}

/**
 * Adds responsive-right alignment if document "embedded with thumbnail" view mode is selected
 */
function portland_media_embed_helper_entity_embed_dialog_submit(array &$form, FormStateInterface $form_state)
{
  $entity = $form_state->get('entity');
  if ($entity->bundle() === 'document') {
    if ($form_state->getValue(['attributes', 'data-entity-embed-display']) === 'view_mode:media.embedded_with_thumbnail') {
      $form_state->setValue(['attributes', 'data-align'], 'responsive-right');
    } else {
      $form_state->unsetValue(['attributes', 'data-align']);
    }
  } else if ($entity->bundle() === 'image') {
    $alt_override = $form_state->getValue(['attributes', 'data-alt-override']);
    if ($alt_override) {
      // Replace line breaks with space in the alt override text.
      $form_state->setValue(
        ['attributes', 'data-alt-override'],
        preg_replace('/\s+/', ' ', $alt_override)
      );
    }
   }
}

function portland_media_embed_helper_after_build($form, &$form_state)
{
  $form['actions']['back']['#value'] = t("Select a different entity");
  return $form;
}

/**
 * Implements hook_form_alter().
 * Causes media form submit to redirect to the group media page, if media is created in the context of a group.
 */
function portland_media_embed_helper_form_media_form_alter(array &$form, FormStateInterface $form_state, $form_id)
{
  $route_match = \Drupal::service('current_route_match');
  $group = $route_match->getParameter('group');
  if (isset($group)) {
    $form['actions']['submit']['#submit'][] = '_portland_media_embed_helper_redirect_to_group_media';
  }
}

function _portland_media_embed_helper_redirect_to_group_media(array $form, FormStateInterface $form_state)
{
  $route_match = \Drupal::service('current_route_match');
  $group = $route_match->getParameter('group');
  $url = \Drupal::service('path.validator')->getUrlIfValid('/group/' . $group->id->value . '/media');
  $form_state->setRedirectUrl($url);
}

// Add a variable so Twig template media--map.html.twig can check if it's being used inside CKEditor
function portland_media_embed_helper_preprocess_media__map(&$variables)
{
  if (isset($_REQUEST['text']) && strpos($_REQUEST['text'], '<drupal-entity ') === 0) {
    $variables['map_embeded_in_ckeditor'] = true;
  }
  // Set the media name in the field_geo_file field's render array for use in the twig template
  if (isset($variables['name']) && isset($variables['content']['field_geo_file'][0]['#map'])) {
    $variables["content"]["field_geo_file"][0]["#map"]['media_name'] = $variables['name'];
  }
}

/**
 * Implements hook_media_presave()
 */
function portland_media_embed_helper_media_presave($media)
{
  // Copy Preview Image file into Thumbnail. Do nothing if Preview Image is empty.
  if (
    $media->hasField('field_preview_image') &&
    $media->hasField('thumbnail') &&
    ! empty($media->field_preview_image->target_id)
  ) {
    $media->thumbnail->target_id = $media->field_preview_image->target_id;
  }
}

/**
 * Implements hook_editor_js_settings_alter().
 *
 * TEMPORARY: This is a temporary workaround to remove the insert_content_fragment button from the simplified_editor_with_media_embed format's toolbar
 * unless the user is in the glossary_editor or administrator roles. This is necessary because the button is not yet ready for rollout to the
 * rest of the organiation. Once the feature is ready for widespread release, this code should be removed.
 */
function portland_media_embed_helper_editor_js_settings_alter(array &$settings, ?Editor $editor = NULL) {
  $account = \Drupal::currentUser();

  // Only show the button if the user is in glossary_editor or administrator roles.
  $roles = $account->getRoles();
  if (in_array('glossary_editor', $roles, true) || in_array('administrator', $roles, true)) {
    return;
  }

  // Remove the insert_content_fragment button from this format's toolbar.
  if (isset($settings["editor"]["formats"]["simplified_editor_with_media_embed"])) {
    $settings["editor"]["formats"]["simplified_editor_with_media_embed"]["editorSettings"]["toolbar"]["items"] = array_values(
      array_filter(
        $settings["editor"]["formats"]["simplified_editor_with_media_embed"]["editorSettings"]["toolbar"]["items"],
        fn($item) => $item !== 'insert_content_fragment'
      )
    );
  }
}

/**
 * Implements hook_preprocess_media().
 */
function portland_media_embed_helper_preprocess_media(&$variables) {
    /** @var \Drupal\media\Entity\Media $media */
  $media = $variables['media'];
  $view_mode = $variables['view_mode'] ?? '';

  // Ensure we have a human-friendly name to use as the title.
  $name = $variables['name'] ?? $media->label();

  // Set title attribute for the field_media_media_remote field in iFrame Embed media.
  if ($media->hasField('field_media_media_remote') && !empty($variables['content']['field_media_media_remote'])) {
    foreach ($media->get('field_media_media_remote') as $delta => $item) {
      if (isset($variables['content']['field_media_media_remote'][$delta])) {
        // Ensure attributes array exists.
        $variables['content']['field_media_media_remote'][$delta]['#attributes'] = $variables['content']['field_media_media_remote'][$delta]['#attributes'] ?? [];
        // Set the title attribute to the media name.
        $variables['content']['field_media_media_remote'][$delta]['#attributes']['title'] = $name;
      }
    }
  }
}
