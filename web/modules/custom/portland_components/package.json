{
  "name": "@cityofportland/portlandor-components-wrapper",
  "private": true,
  "description": "Wrapper to copy Drupal component library",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "find . -mindepth 1 -maxdepth 1  ! -name 'package.json' ! -name '.gitignore' ! -name 'node_modules' -exec rm -rf {} + && cp -r node_modules/@cityofportland/components-drupal/dist/* ."
  },
  "dependencies": {
    "@cityofportland/components-drupal": "1.0.0-alpha.7"
  }
}
